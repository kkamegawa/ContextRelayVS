<UserControl x:Class="ContextRelay.VSExtension.Package.Options.EmbeddedOptionsControl"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
             ClipToBounds="True">
    <UserControl.Resources>
        <!-- Match the system palette used by UIElementDialogPage's native dialog host. -->
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="75" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" />
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <AccessText Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldMessage" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <CheckBox x:Name="EnableRetrieval" Content="{Binding [EnableRetrieval]}" />
            <TextBlock Margin="0,8,0,0" Text="{Binding [Prerequisites]}" TextWrapping="Wrap" />
            <TextBlock x:Name="CloudWarning" Margin="0,8,0,0" FontWeight="SemiBold"
                       Text="{Binding [CloudWarning]}" TextWrapping="Wrap" />

            <Label x:Name="SourcesLabel" Target="{Binding ElementName=Sources}"
                   Content="{Binding [Sources]}" FontWeight="SemiBold" Padding="0" Margin="0,16,0,4" />
            <ListBox x:Name="Sources" MinHeight="72" MaxHeight="160" Style="{x:Null}"
                     AutomationProperties.LabeledBy="{Binding ElementName=SourcesLabel}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="6,3" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding Status}" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Source.Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ShortId}" ToolTip="{Binding Source.ContainerTypeId}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyList" Text="{Binding [NoSources]}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <WrapPanel x:Name="ListActions" Margin="0,8,0,0">
                <Button x:Name="AddSource" Content="{Binding [Add]}" Click="OnAdd" />
                <Button x:Name="EditSource" Content="{Binding [Edit]}" Click="OnEdit" IsEnabled="False" />
                <Button x:Name="RemoveSource" Content="{Binding [Remove]}" Click="OnRemove" IsEnabled="False" />
            </WrapPanel>

            <StackPanel x:Name="Editor" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="EditorHeading" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Label x:Name="NameLabel" Target="{Binding ElementName=SourceName}" Content="{Binding [Name]}" Padding="0" />
                <TextBox x:Name="SourceName" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                         AutomationProperties.HelpText="{Binding Text, ElementName=NameError}" />
                <TextBlock x:Name="NameError" Style="{StaticResource FieldMessage}" />
                <Label x:Name="IdLabel" Target="{Binding ElementName=ContainerTypeId}"
                       Content="{Binding [ContainerTypeId]}" Margin="0,8,0,0" Padding="0" />
                <TextBox x:Name="ContainerTypeId" AutomationProperties.LabeledBy="{Binding ElementName=IdLabel}"
                         AutomationProperties.HelpText="{Binding Text, ElementName=IdError}" />
                <TextBlock x:Name="IdError" Style="{StaticResource FieldMessage}" />
                <CheckBox x:Name="EnableSource" Content="{Binding [EnableSource]}" Margin="0,8,0,0" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="{Binding [SaveSource]}" Click="OnSaveSource" />
                    <Button Content="{Binding [DiscardSource]}" Click="OnDiscardSource" />
                </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="SaveError" Style="{StaticResource FieldMessage}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
