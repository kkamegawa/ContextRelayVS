<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <DataTemplate.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Fluent geometry stays local to this Remote UI template. Colors remain dynamic
             Visual Studio resources so the UI follows theme changes without a custom palette. -->
        <Style x:Key="SurfaceBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowContentGridBrushKey}}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PanelSurfaceBorderStyle" TargetType="Border" BasedOn="{StaticResource SurfaceBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource SurfaceBorderStyle}">
            <Setter Property="Margin" Value="8,8,8,0" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="CardContentBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardBodyTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ThemedButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowContentGridBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" SnapsToDevicePixels="True">
                            <Border x:Name="ButtonChrome" Margin="1" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarHoverBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextHoverBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBrushKey}}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBorderBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextSelectedBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextInactiveBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemHighlightTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemHighlightBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemHighlightBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" SnapsToDevicePixels="True">
                            <Border x:Name="ButtonChrome" Margin="1" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarHoverOverSelectedBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextHoverOverSelectedBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBrushKey}}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBorderBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextSelectedBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextInactiveBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <!-- Pixel scrolling keeps the bottom of a message taller than the viewport reachable. -->
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="FluentListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,8,8,0" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowContentGridBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarHoverBrushKey}}" />
                                <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarHoverBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextHoverBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBrushKey}}" />
                                <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBrushKey}}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBorderBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextSelectedBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBorderBrushKey}}" />
                                <Setter TargetName="ItemChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                                <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextInactiveBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowContentGridBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemHighlightBrushKey}}" />
            <Setter Property="SelectionTextBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemHighlightTextBrushKey}}" />
            <Setter Property="SelectionOpacity" Value="1" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" SnapsToDevicePixels="True">
                            <Border x:Name="TextBoxChrome" Margin="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextInactiveBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Read-only, selectable text for previews and answers. PART_ContentHost is a Decorator rather
             than a ScrollViewer so the surrounding list keeps the mouse wheel (Remote UI has no code-behind
             to forward it), and IsTabStop is off so long content does not add Tab stops. -->
        <Style x:Key="SelectableTextStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="IsUndoEnabled" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemHighlightBrushKey}}" />
            <Setter Property="SelectionTextBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemHighlightTextBrushKey}}" />
            <Setter Property="SelectionOpacity" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Decorator x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SuggestionButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="SuggestionPopupListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource ThemedListBoxStyle}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="SuggestionListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource FluentListBoxItemStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="ThemedTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTabTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTabGradientBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTabBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTabSelectedTabBrushKey}}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTabSelectedBorderBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTabSelectedTextBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTabMouseOverBackgroundGradientBrushKey}}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTabMouseOverBorderBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTabMouseOverTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </DataTemplate.Resources>

    <Grid Margin="8"
          Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          FocusManager.IsFocusScope="True"
          FocusManager.FocusedElement="{Binding ElementName=QueryTextBox}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: account and status on one or two lines; the usage help only appears before the
             first request, while a suggestion is highlighted, or after a failure. -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceBorderStyle}" Padding="10,6" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Margin="0,0,12,0" Style="{StaticResource SectionHeaderTextStyle}" Text="{Binding WindowTitleText}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding SignedInUserText}" Style="{StaticResource MutedTextStyle}" />
                </WrapPanel>
                <TextBlock Margin="0,2,0,0" Text="{Binding StatusMessage}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,0" Text="{Binding HelpText}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                           Visibility="{Binding ShowHelpText, Converter={StaticResource BoolToVisConverter}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelSurfaceBorderStyle}">
            <TabControl Background="Transparent"
                        BorderThickness="0"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Style="{StaticResource ThemedTabItemStyle}" Header="{Binding ChatTabHeaderText}">
                <Grid>
                    <Grid.Resources>
                        <Style x:Key="StreamingPreviewBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource StreamingPreviewBorderStyle}"
                            Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ChatHistoryHeaderText}"
                                       Style="{StaticResource CardTitleTextStyle}"
                                       Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <ScrollViewer Margin="0,6,0,0" MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding StreamingResponseText}" Style="{StaticResource BodyTextStyle}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                <ListBox Grid.Row="1" Style="{StaticResource ThemedListBoxStyle}" ItemContainerStyle="{StaticResource FluentListBoxItemStyle}" ItemsSource="{Binding ChatHistory}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardContentBorderStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardTitleTextStyle}" Text="{Binding Role}" />
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding Timestamp}" Style="{StaticResource CardMutedTextStyle}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Text}" Style="{StaticResource CardBodyTextStyle}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CardMutedTextStyle}"
                                               Visibility="{Binding HasContextLabels, Converter={StaticResource BoolToVisConverter}}">
                                        <Run Text="{Binding ContextLabelsPrefixText}" />
                                        <Run Text="{Binding ContextLabelsJoinedDisplay}" />
                                    </TextBlock>
                                    <WrapPanel Margin="0,12,0,0"
                                               Visibility="{Binding IsActionableAssistant, Converter={StaticResource BoolToVisConverter}}">
                                        <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,8,8" Content="{Binding CopyAssistantButtonText}" Command="{Binding CopyAssistantCommand}" />
                                        <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,8,8" Content="{Binding AppendAssistantButtonText}" Command="{Binding AppendAssistantCommand}" />
                                        <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,8,8" Content="{Binding ReplaceAssistantButtonText}" Command="{Binding ReplaceAssistantCommand}" />
                                        <Button Style="{StaticResource ThemedButtonStyle}"
                                                Margin="0,0,8,8"
                                                Content="{Binding ContinueAssistantButtonText}"
                                                Command="{Binding ContinueAssistantCommand}"
                                                Visibility="{Binding IsLatestCopilotAssistant, Converter={StaticResource BoolToVisConverter}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
                </TabItem>

                    <TabItem Style="{StaticResource ThemedTabItemStyle}" Header="{Binding ResultsTabHeaderText}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <Border Style="{StaticResource CardBorderStyle}"
                                        Visibility="{Binding HasSearchSummary, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{Binding SearchSummaryHeaderText}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding SearchSummary}"
                                                   Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Margin="10,6,10,0" Text="{Binding EmbeddedPreviewNoticeText}" Style="{StaticResource MutedTextStyle}"
                                           Visibility="{Binding HasEmbeddedResults, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>

                            <ListBox Grid.Row="1" Style="{StaticResource ThemedListBoxStyle}" ItemContainerStyle="{StaticResource FluentListBoxItemStyle}" ItemsSource="{Binding SearchResults}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardContentBorderStyle}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding PinButtonText}" Command="{Binding PinCommand}" />
                                                    <MenuItem Header="{Binding CopyMenuText}" Command="{Binding CopyCommand}" />
                                                    <MenuItem Header="{Binding AppendToHandoffMenuText}" Command="{Binding AppendToHandoffCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="{Binding OpenInBrowserMenuText}" Command="{Binding OpenCommand}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Title}" />
                                                <WrapPanel Margin="0,4,0,0">
                                                    <TextBlock Margin="0,0,4,4" Text="{Binding SourceIcon}" Style="{StaticResource CardMutedTextStyle}" />
                                                    <TextBlock Margin="0,0,8,4" Text="{Binding SourceLabel}" Style="{StaticResource CardMutedTextStyle}" />
                                                    <Border Style="{StaticResource BadgeBorderStyle}"
                                                            Visibility="{Binding IsEmbedded, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="{Binding EmbeddedPreviewBadgeText}" Style="{StaticResource CardMutedTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeBorderStyle}"
                                                            Visibility="{Binding HasSensitivityLabel, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="{Binding SensitivityLabelText}" Style="{StaticResource CardMutedTextStyle}" />
                                                    </Border>
                                                    <TextBlock Margin="0,0,0,4" Text="{Binding Timestamp}" Style="{StaticResource CardMutedTextStyle}" />
                                                </WrapPanel>
                                                <TextBlock Margin="0,4,0,0" Text="{Binding Snippet}" Style="{StaticResource CardBodyTextStyle}" />
                                                <Border Margin="0,8,0,0" Padding="8" Style="{StaticResource SurfaceBorderStyle}" Background="Transparent"
                                                        Visibility="{Binding IsPreviewExpanded, Converter={StaticResource BoolToVisConverter}}">
                                                    <StackPanel>
                                                        <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding PreviewText, Mode=OneWay}" />
                                                        <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                                Content="{Binding CopyPreviewButtonText}" Command="{Binding CopyPreviewCommand}" />
                                                    </StackPanel>
                                                </Border>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,8,8" Content="{Binding PreviewButtonText}" Command="{Binding TogglePreviewCommand}"
                                                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisConverter}}" />
                                                    <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,8,8" Content="{Binding PinButtonText}" Command="{Binding PinCommand}" />
                                                    <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,0,8" Content="{Binding OpenButtonText}" Command="{Binding OpenCommand}"
                                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisConverter}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Style="{StaticResource ThemedTabItemStyle}" Header="{Binding PinsTabHeaderText}">
                        <ListBox Style="{StaticResource ThemedListBoxStyle}" ItemContainerStyle="{StaticResource FluentListBoxItemStyle}" ItemsSource="{Binding Snippets}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardContentBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Name}" />
                                            <WrapPanel Margin="0,4,0,0">
                                                <TextBlock Margin="0,0,4,4" Text="{Binding SourceIcon}" Style="{StaticResource CardMutedTextStyle}" />
                                                <TextBlock Margin="0,0,8,4" Text="{Binding SourceLabel}" Style="{StaticResource CardMutedTextStyle}" />
                                                <Border Style="{StaticResource BadgeBorderStyle}"
                                                        Visibility="{Binding IsEmbedded, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{Binding EmbeddedPreviewBadgeText}" Style="{StaticResource CardMutedTextStyle}" />
                                                </Border>
                                                <Border Style="{StaticResource BadgeBorderStyle}"
                                                        Visibility="{Binding HasSensitivityLabel, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{Binding SensitivityLabelText}" Style="{StaticResource CardMutedTextStyle}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Snippet}" Style="{StaticResource CardBodyTextStyle}" />
                                            <Border Margin="0,8,0,0" Padding="8" Style="{StaticResource SurfaceBorderStyle}" Background="Transparent"
                                                    Visibility="{Binding IsPreviewExpanded, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel>
                                                    <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding PreviewText, Mode=OneWay}" />
                                                    <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                            Content="{Binding CopyPreviewButtonText}" Command="{Binding CopyPreviewCommand}" />
                                                </StackPanel>
                                            </Border>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,8,8" Content="{Binding PreviewButtonText}" Command="{Binding TogglePreviewCommand}"
                                                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisConverter}}" />
                                                <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,8,8" Content="{Binding OpenButtonText}" Command="{Binding OpenCommand}"
                                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisConverter}}" />
                                                <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,0,8" Content="{Binding DeleteButtonText}" Command="{Binding DeleteCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <!-- The Embedded source chip and selector show only for an /embedded draft; GUIDs never appear. -->
            <StackPanel Margin="0,0,0,8" Visibility="{Binding ShowEmbeddedSourceBar, Converter={StaticResource BoolToVisConverter}}">
                <WrapPanel>
                    <Border Style="{StaticResource BadgeBorderStyle}" Padding="8,4">
                        <TextBlock Text="{Binding EmbeddedSourceChipText}" Style="{StaticResource BodyTextStyle}" />
                    </Border>
                    <Button Style="{StaticResource ThemedButtonStyle}" Margin="0,0,0,4" MinHeight="26" Padding="8,2"
                            Content="{Binding ChangeEmbeddedSourceButtonText}" Command="{Binding ChangeEmbeddedSourceCommand}"
                            Visibility="{Binding CanChangeEmbeddedSource, Converter={StaticResource BoolToVisConverter}}" />
                </WrapPanel>
                <TextBlock Text="{Binding EmbeddedPreviewNoticeText}" Style="{StaticResource MutedTextStyle}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding EmbeddedInvalidSourcesText}" Style="{StaticResource MutedTextStyle}"
                           Visibility="{Binding HasEmbeddedInvalidSources, Converter={StaticResource BoolToVisConverter}}" />
                <Border Margin="0,6,0,0" Padding="4" Style="{StaticResource SurfaceBorderStyle}"
                        Visibility="{Binding IsEmbeddedSourceSelectorOpen, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <TextBlock Margin="8,4,8,6" FontWeight="SemiBold" Text="{Binding EmbeddedSourceSelectorHeaderText}" Style="{StaticResource MutedTextStyle}" />
                        <ListBox Style="{StaticResource SuggestionPopupListBoxStyle}" MaxHeight="180" BorderThickness="0"
                                 ItemsSource="{Binding EmbeddedSourceOptions}"
                                 ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="EmbeddedSourceRow" Style="{StaticResource SuggestionButtonStyle}" Command="{Binding SelectCommand}">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter TargetName="EmbeddedSourceRow" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBrushKey}}" />
                                            <Setter TargetName="EmbeddedSourceRow" Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextSelectedBrushKey}}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Margin="0,0,0,8"
                    Padding="4"
                    Style="{StaticResource SurfaceBorderStyle}"
                    Visibility="{Binding IsCommandPopupOpen, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock Margin="8,4,8,6" FontWeight="SemiBold" Text="{Binding CommandPopupHeaderText}" Style="{StaticResource MutedTextStyle}" />
                     <ListBox Style="{StaticResource SuggestionPopupListBoxStyle}" MaxHeight="220" BorderThickness="0"
                              ItemsSource="{Binding VisibleCommandSuggestions}"
                              ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}">
                         <ListBox.ItemTemplate>
                             <DataTemplate>
                                 <Button x:Name="SuggestionRow" Style="{StaticResource SuggestionButtonStyle}" Command="{Binding ApplyCommand}">
                                     <StackPanel>
                                         <StackPanel Orientation="Horizontal">
                                             <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                             <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                         </StackPanel>
                                         <TextBlock Margin="0,3,0,0"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Text="{Binding Description}"
                                                    Style="{StaticResource CardMutedTextStyle}" />
                                     </StackPanel>
                                 </Button>
                                 <DataTemplate.Triggers>
                                     <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                         <Setter TargetName="SuggestionRow" Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarSelectedBrushKey}}" />
                                         <Setter TargetName="SuggestionRow" Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.CommandBarTextSelectedBrushKey}}" />
                                     </DataTrigger>
                                 </DataTemplate.Triggers>
                             </DataTemplate>
                         </ListBox.ItemTemplate>
                     </ListBox>
                </StackPanel>
            </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8" MaxHeight="96"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding PendingAttachments}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,6,4" Padding="6,2" HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource CardMutedTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MinWidth="0" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource ThemedButtonStyle}" Padding="6,2" MinHeight="24" Content="{Binding RemoveButtonText}" AutomationProperties.Name="{Binding RemoveAutomationName}" Command="{Binding RemoveCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Style="{StaticResource ThemedButtonStyle}" Grid.Row="2" Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Bottom"
                    Content="{Binding AddFilesButtonText}"
                    AutomationProperties.Name="{Binding AddFilesToolTipText}"
                    ToolTip="{Binding AddFilesToolTipText}"
                    Command="{Binding AddFilesCommand}" />

            <!-- Enter is the only key binding for submit; Shift+Enter falls through to the text box's
                 own line-break command, and an IME composing Enter arrives as ImeProcessed. -->
            <TextBox x:Name="QueryTextBox"
                     Style="{StaticResource ThemedTextBoxStyle}" Grid.Row="2" Grid.Column="1"
                      Margin="0,0,8,0"
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      MinHeight="32"
                      MaxHeight="120"
                      VerticalContentAlignment="Top"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="{Binding SearchToolTipText}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ConfirmQueryInputCommand}" />
                    <KeyBinding Key="Down" Command="{Binding MoveSelectionDownCommand}" />
                    <KeyBinding Key="Up" Command="{Binding MoveSelectionUpCommand}" />
                    <KeyBinding Key="Tab" Command="{Binding ApplyCommandSelectionCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding CloseCommandPopupCommand}" />
                </TextBox.InputBindings>

            </TextBox>
            <Button Style="{StaticResource PrimaryButtonStyle}" Grid.Row="2" Grid.Column="2"
                    MinWidth="72"
                    VerticalAlignment="Bottom"
                    Content="{Binding PrimaryActionButtonText}"
                    ToolTip="{Binding PrimaryActionButtonText}"
                    AutomationProperties.Name="{Binding PrimaryActionButtonText}"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding IsPrimaryActionEnabled}" />
        </Grid>
    </Grid>
</DataTemplate>
