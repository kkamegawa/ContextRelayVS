<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>NU1603;NU1605;VSEXTPREVIEW_OUTPUTWINDOW</NoWarn>
    <RootNamespace>ContextRelay.VSExtension</RootNamespace>
    <AssemblyName>ContextRelay.VSExtension</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/kkamegawa/ContextRelayVS</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Dependency submission restores projects on Linux runners as well as on Windows.
         Enable Windows targeting there so restore can evaluate this Windows-only project
         without requiring the workflow to special-case or skip it. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <!-- Always launch the debugging target with an explicit activity log path so
         registration failures are diagnosable even when Visual Studio does not
         emit its default ActivityLog.xml automatically. -->
    <VisualStudioActivityLogPath>$([System.IO.Path]::Combine('$(APPDATA)', 'Microsoft', 'VisualStudio', 'ContextRelayVS-Exp-ActivityLog.xml'))</VisualStudioActivityLogPath>
    <!-- Path properties for the in-proc package. The net48 package is built as a
         peer project; its DLL, generated pkgdef, and toolkit dependency are
         injected into the produced VSIX zip by PatchVsixForInProcPackage so that
         VSIXInstaller / Marketplace installs register Tools > Options for VS via
         the Extension Manager pipeline. We do not perform sidecar deployment. -->
    <InProcPackageTargetFramework>net48</InProcPackageTargetFramework>
    <VsixExtensionId>ContextRelayVS.KazushiKamegawa.d0dd4dd5-7d88-4b80-8d4d-9dd18fa4cf11</VsixExtensionId>
    <InProcPackageBinDir>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '..', 'ContextRelay.VSExtension.Package', 'bin', '$(Configuration)', '$(InProcPackageTargetFramework)'))</InProcPackageBinDir>
    <InProcPackageObjDir>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '..', 'ContextRelay.VSExtension.Package', 'obj', '$(Configuration)', '$(InProcPackageTargetFramework)'))</InProcPackageObjDir>
    <InProcPackageDllPath>$([System.IO.Path]::Combine('$(InProcPackageBinDir)', 'ContextRelay.VSExtension.Package.dll'))</InProcPackageDllPath>
    <InProcPackageJapaneseResourcesPath>$([System.IO.Path]::Combine('$(InProcPackageBinDir)', 'ja', 'ContextRelay.VSExtension.Package.resources.dll'))</InProcPackageJapaneseResourcesPath>
    <InProcPackagePkgdefPath>$([System.IO.Path]::Combine('$(InProcPackageObjDir)', 'ContextRelay.VSExtension.Package.pkgdef'))</InProcPackagePkgdefPath>
    <InProcToolkitAssemblyPath>$([System.IO.Path]::Combine('$(InProcPackageBinDir)', 'Community.VisualStudio.Toolkit.dll'))</InProcToolkitAssemblyPath>
    <SourceVsixManifestPath>$(MSBuildProjectDirectory)\source.extension.vsixmanifest</SourceVsixManifestPath>
    <ImageAssetsPath>Images</ImageAssetsPath>
  </PropertyGroup>

  <Import Project="..\..\build\ContextRelay.Build.props" />

  <ItemGroup>
    <Compile Include="..\Shared\VisualStudioLanguageService.cs" Link="Services\VisualStudioLanguageService.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="icon.png" />
  </ItemGroup>

  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp /log "$(VisualStudioActivityLogPath)"</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContextRelay.Core\ContextRelay.Core.csproj" />
    <!-- The in-proc package targets net48 and must not enter the net8 OOP compile graph.
         We build it as a dependency so its DLL and pkgdef exist before we patch the VSIX,
         but ReferenceOutputAssembly=false keeps its assembly out of the net8 reference set.
         IncludeOutputGroupsInVSIX is empty to ensure the SDK does not try to materialize
         net48 outputs via |...| token paths (that produces the "%CurrentProject%" failure
         seen for Microsoft.VisualStudio.Copilot.Testing.UI in v18). Payload injection is
         performed AFTER CreateVsixContainer by PatchVsixForInProcPackage. -->
    <ProjectReference Include="..\ContextRelay.VSExtension.Package\ContextRelay.VSExtension.Package.csproj">
      <Name>ContextRelay.VSExtension.Package</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <IncludeOutputGroupsInVSIX></IncludeOutputGroupsInVSIX>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="LICENSE.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="MessagePack" Version="3.1.9" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility" Version="17.14.2098" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Page Remove="ToolWindows\ContextRelayWindowContent.xaml" />
    <EmbeddedResource Include="ToolWindows\ContextRelayWindowContent.xaml">
      <LogicalName>ContextRelay.VSExtension.ToolWindows.ContextRelayWindowContent.xaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    VisualStudio.Extensibility resolves command and menu display names from the
    .vsextension/string-resources.json files, choosing the file that matches the
    Visual Studio UI language (the installed language pack) and falling back to the
    default English file. The generated extension.json therefore keeps every
    %ContextRelay.*% token instead of baking in English text. This task only
    validates the metadata. The set of tokens in extension.json, the keys of the
    English file, and the keys of the Japanese file must all be identical, and the
    same must hold for the copies that ship inside the VSIX, because Visual Studio
    reads the packaged files. That leaves no language a raw token to fall through to
    and no resource that nothing references.
  -->
  <UsingTask TaskName="ValidateContextRelayMenuMetadata" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ExtensionJsonPath ParameterType="System.String" Required="false" />
      <VsixPath ParameterType="System.String" Required="false" />
      <ResourcesDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code>
        <![CDATA[
        try
        {
            // Source files: the two languages must define exactly the same keys.
            HashSet<string> english = ReadResourceKeys(File.ReadAllText(Path.Combine(ResourcesDirectory, "string-resources.json"), Encoding.UTF8), "string-resources.json");
            HashSet<string> japanese = ReadResourceKeys(File.ReadAllText(Path.Combine(ResourcesDirectory, "ja", "string-resources.json"), Encoding.UTF8), "ja/string-resources.json");
            RequireSameKeys(english, "string-resources.json", japanese, "ja/string-resources.json");

            if (!string.IsNullOrWhiteSpace(ExtensionJsonPath) && File.Exists(ExtensionJsonPath))
            {
                // Build output: validate the deployed resource copies, because those are what the built
                // manifest sits beside and what Visual Studio reads from the build output.
                string outputResourcesDirectory = Path.GetDirectoryName(ExtensionJsonPath);
                HashSet<string> outputEnglish = ReadResourceKeys(File.ReadAllText(Path.Combine(outputResourcesDirectory, "string-resources.json"), Encoding.UTF8), "output string-resources.json");
                HashSet<string> outputJapanese = ReadResourceKeys(File.ReadAllText(Path.Combine(outputResourcesDirectory, "ja", "string-resources.json"), Encoding.UTF8), "output ja/string-resources.json");
                RequireSameKeys(outputEnglish, "output string-resources.json", outputJapanese, "output ja/string-resources.json");
                RequireSameKeys(FindTokens(File.ReadAllText(ExtensionJsonPath, Encoding.UTF8)), "output extension.json tokens", outputEnglish, "output string-resources.json");
            }

            if (!string.IsNullOrWhiteSpace(VsixPath) && File.Exists(VsixPath))
            {
                using (ZipArchive zip = ZipFile.Open(VsixPath, ZipArchiveMode.Read))
                {
                    // Visual Studio reads the packaged copies, not the source files, so validate those.
                    string manifestText = ReadEntry(zip, ".vsextension/extension.json");
                    string englishText = ReadEntry(zip, ".vsextension/string-resources.json");
                    string japaneseText = ReadEntry(zip, ".vsextension/ja/string-resources.json");
                    if (manifestText == null || englishText == null || japaneseText == null)
                    {
                        return false;
                    }

                    HashSet<string> packagedEnglish = ReadResourceKeys(englishText, "packaged .vsextension/string-resources.json");
                    HashSet<string> packagedJapanese = ReadResourceKeys(japaneseText, "packaged .vsextension/ja/string-resources.json");
                    RequireSameKeys(packagedEnglish, "packaged string-resources.json", packagedJapanese, "packaged ja/string-resources.json");
                    RequireSameKeys(FindTokens(manifestText), "packaged extension.json tokens", packagedEnglish, "packaged string-resources.json");
                }
            }
        }
        catch (Exception ex)
        {
            Log.LogError("ValidateContextRelayMenuMetadata failed: {0}", ex.ToString());
            return false;
        }

        return !Log.HasLoggedErrors;

        string ReadEntry(ZipArchive zip, string name)
        {
            ZipArchiveEntry entry = zip.GetEntry(name);
            if (entry == null)
            {
                Log.LogError("VSIX is missing {0}: {1}", name, VsixPath);
                return null;
            }

            using (var stream = entry.Open())
            using (var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true))
            {
                return reader.ReadToEnd();
            }
        }

        HashSet<string> ReadResourceKeys(string json, string label)
        {
            // Parses the file as real JSON instead of scanning for key-looking lines, so a structurally
            // malformed file (for example a missing comma between two properties) is rejected here
            // instead of letting the build succeed with a resource file Visual Studio cannot load. The
            // parser is self-contained (no assembly reference resolvable from this inline task) and is
            // intentionally narrow: it accepts only the shape these files are defined to have, a single
            // flat JSON object of string values, and treats anything else (nesting, a non-string value, a
            // duplicate key, trailing content) as a failure.
            var keys = new HashSet<string>(StringComparer.Ordinal);
            try
            {
                ParseFlatStringObjectKeys(json, keys);
            }
            catch (FormatException ex)
            {
                Log.LogError("{0} is not a valid flat JSON object of string values: {1}", label, ex.Message);
                return keys;
            }

            if (keys.Count == 0)
            {
                Log.LogError("{0} defines no resource keys; it is empty or malformed.", label);
            }

            return keys;
        }

        void ParseFlatStringObjectKeys(string json, HashSet<string> keys)
        {
            int pos = 0;

            SkipWhitespace();
            Expect('{');
            SkipWhitespace();
            if (TryConsume('}'))
            {
                SkipWhitespace();
                RequireEndOfInput();
                return;
            }

            while (true)
            {
                SkipWhitespace();
                string key = ParseString();
                if (!keys.Add(key))
                {
                    throw new FormatException(string.Format("duplicate key '{0}' at position {1}", key, pos));
                }

                SkipWhitespace();
                Expect(':');
                SkipWhitespace();
                if (Peek() != '"')
                {
                    throw new FormatException(string.Format("value for key '{0}' at position {1} must be a JSON string", key, pos));
                }

                ParseString();
                SkipWhitespace();

                if (TryConsume(','))
                {
                    continue;
                }

                Expect('}');
                break;
            }

            SkipWhitespace();
            RequireEndOfInput();

            char Peek()
            {
                if (pos >= json.Length)
                {
                    throw new FormatException("unexpected end of input");
                }

                return json[pos];
            }

            bool TryConsume(char c)
            {
                if (pos < json.Length && json[pos] == c)
                {
                    pos++;
                    return true;
                }

                return false;
            }

            void Expect(char c)
            {
                if (Peek() != c)
                {
                    throw new FormatException(string.Format("expected '{0}' at position {1}", c, pos));
                }

                pos++;
            }

            void SkipWhitespace()
            {
                // JSON (RFC 8259) permits only these four characters between tokens. char.IsWhiteSpace
                // also accepts other Unicode separators (e.g. NBSP, U+2028), which would let this
                // validator accept a file the runtime JSON parser rejects.
                while (pos < json.Length && IsJsonWhitespace(json[pos]))
                {
                    pos++;
                }
            }

            bool IsJsonWhitespace(char c) => c == ' ' || c == '\t' || c == '\n' || c == '\r';

            void RequireEndOfInput()
            {
                if (pos != json.Length)
                {
                    throw new FormatException(string.Format("unexpected content at position {0} after the closing '}}'", pos));
                }
            }

            string ParseString()
            {
                Expect('"');
                var builder = new StringBuilder();
                while (true)
                {
                    if (pos >= json.Length)
                    {
                        throw new FormatException("unterminated string");
                    }

                    char c = json[pos++];
                    if (c == '"')
                    {
                        break;
                    }

                    if (c == '\\')
                    {
                        if (pos >= json.Length)
                        {
                            throw new FormatException("unterminated escape sequence");
                        }

                        char escape = json[pos++];
                        switch (escape)
                        {
                            case '"': builder.Append('"'); break;
                            case '\\': builder.Append('\\'); break;
                            case '/': builder.Append('/'); break;
                            case 'b': builder.Append('\b'); break;
                            case 'f': builder.Append('\f'); break;
                            case 'n': builder.Append('\n'); break;
                            case 'r': builder.Append('\r'); break;
                            case 't': builder.Append('\t'); break;
                            case 'u':
                                if (pos + 4 > json.Length)
                                {
                                    throw new FormatException("truncated unicode escape");
                                }

                                builder.Append((char)Convert.ToInt32(json.Substring(pos, 4), 16));
                                pos += 4;
                                break;
                            default:
                                throw new FormatException(string.Format("invalid escape '\\{0}'", escape));
                        }
                    }
                    else if (char.IsControl(c))
                    {
                        throw new FormatException("unescaped control character in string");
                    }
                    else
                    {
                        builder.Append(c);
                    }
                }

                return builder.ToString();
            }
        }

        HashSet<string> FindTokens(string manifestText)
        {
            var tokens = new HashSet<string>(StringComparer.Ordinal);
            foreach (Match match in Regex.Matches(manifestText, "%(ContextRelay\\.[A-Za-z0-9_.]+)%"))
            {
                tokens.Add(match.Groups[1].Value);
            }

            return tokens;
        }

        void RequireSameKeys(HashSet<string> left, string leftName, HashSet<string> right, string rightName)
        {
            foreach (string key in left)
            {
                if (!right.Contains(key))
                {
                    Log.LogError("'{0}' is in {1} but missing from {2}.", key, leftName, rightName);
                }
            }

            foreach (string key in right)
            {
                if (!left.Contains(key))
                {
                    Log.LogError("'{0}' is in {1} but missing from {2}.", key, rightName, leftName);
                }
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="ValidateContextRelayMenuMetadataInOutput" AfterTargets="Build" Condition="Exists('$(TargetDir).vsextension\extension.json')">
    <ValidateContextRelayMenuMetadata ExtensionJsonPath="$(TargetDir).vsextension\extension.json" ResourcesDirectory="$(MSBuildProjectDirectory)\.vsextension" />
  </Target>

  <!--
    PatchVsixContainerAfterCreation: runs after the Extensibility build pipeline produces
    the .vsix archive and rewrites it so a single VSIXInstaller / Marketplace install
    registers both the OOP extension and the in-proc Tools > Options VSPackage. This:
      1. Replaces the OOP-synthesized extension.vsixmanifest with the source manifest's
         Identity / Installation / Dependencies / Prerequisites, then rewrites
         ExtensionType to the hybrid VSSDK+VisualStudio.Extensibility form, preserves
         <DotnetTargetVersions>net8.0</DotnetTargetVersions>, and adds the
         Microsoft.VisualStudio.VsPackage asset.
      2. Injects the in-proc package DLL, its generated pkgdef, and Community.VisualStudio.Toolkit.dll.
      3. Registers the .pkgdef content type in [Content_Types].xml.
    This eliminates the sidecar drop-in path entirely; per VS Insiders v18 evidence, the
    per-user Extensions folder is in ImageManifestSearchPath but NOT in PkgDefSearchPath,
    so sidecar registration is silently ignored. The only reliable registration path is
    via a properly packaged VSIX.
  -->
  <Target Name="PatchVsixContainerAfterCreation" AfterTargets="CreateVsixContainer" Condition="Exists('$(TargetVsixContainer)')">
    <Error Condition="!Exists('$(InProcPackageDllPath)')" Text="In-proc package DLL not found at $(InProcPackageDllPath). Build the package project first." />
    <Error Condition="!Exists('$(InProcPackagePkgdefPath)')" Text="In-proc package pkgdef not found at $(InProcPackagePkgdefPath). Ensure GeneratePkgDef ran during the package project build." />
    <Error Condition="!Exists('$(InProcToolkitAssemblyPath)')" Text="Community.VisualStudio.Toolkit.dll not found at $(InProcToolkitAssemblyPath); the in-proc options package will fail to load without it." />
    <Error Condition="!Exists('$(InProcPackageJapaneseResourcesPath)')" Text="Japanese options resource assembly not found at $(InProcPackageJapaneseResourcesPath)." />
    <Error Condition="!Exists('$(SourceVsixManifestPath)')" Text="Source manifest not found at $(SourceVsixManifestPath)." />
    <PatchVsixForInProcPackage VsixPath="$(TargetVsixContainer)" SourceManifestPath="$(SourceVsixManifestPath)" PackageDllPath="$(InProcPackageDllPath)" PackagePkgdefPath="$(InProcPackagePkgdefPath)" SupportingAssemblies="$(InProcToolkitAssemblyPath);$(InProcPackageJapaneseResourcesPath)|ja/ContextRelay.VSExtension.Package.resources.dll" />
    <Message Importance="High" Text="Patched VSIX $(TargetVsixContainer) with in-proc package payload and hybrid manifest." />
  </Target>

  <Target Name="ValidateContextRelayMenuMetadataInVsix" AfterTargets="PatchVsixContainerAfterCreation" Condition="Exists('$(TargetVsixContainer)')">
    <ValidateContextRelayMenuMetadata VsixPath="$(TargetVsixContainer)" ResourcesDirectory="$(MSBuildProjectDirectory)\.vsextension" />
  </Target>

  <!--
    AssertVsixContents: post-patch build-time assertion that the produced .vsix actually
    contains the files and manifest entries required for Tools > Options registration to
    survive a clean install. Fails the build if any are missing so the regression
    investigated under PR #57 cannot recur silently.
  -->
  <UsingTask TaskName="AssertVsixContents" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <VsixPath ParameterType="System.String" Required="true" />
      <RequiredEntries ParameterType="System.String" Required="true" />
      <RequiredManifestSubstrings ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Linq" />
      <Code>
        <![CDATA[
        try
        {
            if (!File.Exists(VsixPath))
            {
                Log.LogError("VSIX not found at {0}", VsixPath);
                return false;
            }
            string[] entries = RequiredEntries.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
            string[] substrings = RequiredManifestSubstrings.Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries);

            using (ZipArchive zip = ZipFile.OpenRead(VsixPath))
            {
                foreach (string e in entries)
                {
                    string needle = e.Trim();
                    if (string.IsNullOrEmpty(needle)) continue;
                    bool found = zip.Entries.Any(en => string.Equals(en.FullName, needle, StringComparison.OrdinalIgnoreCase));
                    if (!found)
                    {
                        Log.LogError("Produced VSIX is missing required entry: {0}", needle);
                    }
                }

                ZipArchiveEntry manifestEntry = zip.Entries.FirstOrDefault(en => string.Equals(en.FullName, "extension.vsixmanifest", StringComparison.OrdinalIgnoreCase));
                if (manifestEntry == null)
                {
                    Log.LogError("Produced VSIX is missing extension.vsixmanifest");
                    return false;
                }

                string manifestText;
                using (var stream = manifestEntry.Open())
                using (var reader = new StreamReader(stream))
                {
                    manifestText = reader.ReadToEnd();
                }

                foreach (string s in substrings)
                {
                    string needle = s.Trim();
                    if (string.IsNullOrEmpty(needle)) continue;
                    if (manifestText.IndexOf(needle, StringComparison.Ordinal) < 0)
                    {
                        Log.LogError("extension.vsixmanifest in produced VSIX is missing required substring: {0}", needle);
                    }
                }

                if (manifestText.Contains("%CurrentProject%"))
                {
                    Log.LogError("extension.vsixmanifest in produced VSIX contains unresolved %CurrentProject% token");
                }
                if (manifestText.Contains("Version=\"0.0.0.0\""))
                {
                    Log.LogError("extension.vsixmanifest in produced VSIX has Identity Version 0.0.0.0; source manifest version was not preserved");
                }

                if (zip.Entries.Any(en => string.Equals(System.IO.Path.GetFileName(en.FullName), "source.extension.vsixmanifest", StringComparison.OrdinalIgnoreCase)))
                {
                    Log.LogError("Produced VSIX must not include source.extension.vsixmanifest; only extension.vsixmanifest should be packaged.");
                }

                ZipArchiveEntry extensionJsonEntry = zip.Entries.FirstOrDefault(en => string.Equals(en.FullName, ".vsextension/extension.json", StringComparison.OrdinalIgnoreCase));
                if (extensionJsonEntry == null)
                {
                    Log.LogError("Produced VSIX is missing .vsextension/extension.json");
                    return false;
                }

                ZipArchiveEntry setupManifestEntry = zip.Entries.FirstOrDefault(en => string.Equals(en.FullName, "manifest.json", StringComparison.OrdinalIgnoreCase));
                if (setupManifestEntry == null)
                {
                    Log.LogError("Produced VSIX is missing manifest.json");
                    return false;
                }

                string setupManifestText;
                using (var stream = setupManifestEntry.Open())
                using (var reader = new StreamReader(stream))
                {
                    setupManifestText = reader.ReadToEnd();
                }

                // Guard against Marketplace "Part is not listed in the package manifest"
                // failures by requiring manifest.json files[] entries for every required payload file.
                foreach (string requiredFile in entries)
                {
                    string fileName = requiredFile.Trim();
                    if (string.IsNullOrEmpty(fileName))
                    {
                        continue;
                    }

                    string escapedFileName = fileName.Replace("\\", "\\\\").Replace("\"", "\\\"");
                    string manifestNeedle = "\"fileName\":\"/" + escapedFileName + "\"";
                    if (setupManifestText.IndexOf(manifestNeedle, StringComparison.OrdinalIgnoreCase) < 0)
                    {
                        Log.LogError("manifest.json in produced VSIX is missing files[] entry for: /{0}", fileName);
                    }
                }

                System.Text.RegularExpressions.Match manifestIdMatch = System.Text.RegularExpressions.Regex.Match(
                    manifestText,
                    "Identity\\s+Id=\"([^\"]+)\"",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                string manifestId = manifestIdMatch.Success ? manifestIdMatch.Groups[1].Value : string.Empty;

                if (System.Text.RegularExpressions.Regex.IsMatch(
                        setupManifestText,
                        "\"version\"\\s*:\\s*\"0\\.0\\.0\\.0\"",
                        System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                {
                    Log.LogError("manifest.json in produced VSIX still has version 0.0.0.0");
                }

                if (setupManifestText.IndexOf("\\\\Common7\\\\IDE\\\\VSExtensions\\\\", StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    Log.LogError("manifest.json in produced VSIX still routes extensionDir to VSExtensions; expected Extensions for installer validation.");
                }

                if (!string.IsNullOrEmpty(manifestId))
                {
                    if (!System.Text.RegularExpressions.Regex.IsMatch(
                            setupManifestText,
                            "\"id\"\\s*:\\s*\"" + System.Text.RegularExpressions.Regex.Escape(manifestId) + "\"",
                            System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                    {
                        Log.LogError("manifest.json in produced VSIX has an id that does not match extension.vsixmanifest Identity Id: {0}", manifestId);
                    }

                    if (!System.Text.RegularExpressions.Regex.IsMatch(
                            setupManifestText,
                            "\"vsixId\"\\s*:\\s*\"" + System.Text.RegularExpressions.Regex.Escape(manifestId) + "\"",
                            System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                    {
                        Log.LogError("manifest.json in produced VSIX has a vsixId that does not match extension.vsixmanifest Identity Id: {0}", manifestId);
                    }
                }

                if (setupManifestText.IndexOf("ContextRelayVS.kkamegawa", StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    Log.LogError("manifest.json in produced VSIX still contains stale ContextRelayVS.kkamegawa identity text.");
                }

                ZipArchiveEntry catalogEntry = zip.Entries.FirstOrDefault(en => string.Equals(en.FullName, "catalog.json", StringComparison.OrdinalIgnoreCase));
                if (catalogEntry == null)
                {
                    Log.LogError("Produced VSIX is missing catalog.json");
                    return false;
                }

